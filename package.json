{
  "name": "nem-motors",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "npm run lint && npm run build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "autoprefixer": "^10.4.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {
        "content": [
          "./src/**/*.{js,jsx}"
        ],
        "theme": {
          "extend": {
            "colors": {
              "background": "var(--background)",
              "foreground": "var(--foreground)"
            }
          }
        }
      },
      "autoprefixer": {}
    }
  }
}
